{
  "ref": "mls_www_to_canonical",
  "description": "Consolidar www no domínio canônico preservando caminho e consulta",
  "expression": "http.host eq \"www.melhorlavaeseca.com\"",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://melhorlavaeseca.com\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
